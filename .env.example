# Server-side only. Never put these into VITE_* variables or browser storage.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
OHSOME_API_KEY=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Default: openai-compatible HTTPS endpoint; optional key-free local Ollama:
# LLM_PROVIDER=ollama
# LLM_MODEL=phi3:mini
# LLM_BASE_URL=http://127.0.0.1:11434
# Optional absolute runtime cache directory. Mode is selected per assessment request.
# TADS_DATA_ROOT=/absolute/path/to/tads-flood-runtime
